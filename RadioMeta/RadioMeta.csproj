<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>RadioMeta</AssemblyName>
    <RootNamespace>RadioMeta</RootNamespace>
    <Version>1.3.156</Version>
    <AssemblyVersion>1.3.156.0</AssemblyVersion>
    <FileVersion>1.3.156.0</FileVersion>
    <InformationalVersion>1.3.156</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- ===== THE ONE LINE TO CHANGE =====
         The folder with the Emby assemblies Radio Meta is compiled against
         (MediaBrowser.Common/Controller/Model.dll). Relative to this file, or a full path.
         Use the OLDEST Emby you support: the DLL then loads on that Emby and newer ones;
         a DLL built against a newer Emby does not load on older Emby versions.
         These assemblies are only compiled against, never shipped. -->
    <EmbyReferencePath Condition="'$(EmbyReferencePath)' == ''">EmbyReferences\4.10.2</EmbyReferencePath>

    <!-- Test builds against the installed Emby: -p:UseInstalledEmby=true
         (uses -p:EmbySystemDir, default %APPDATA%\Emby-Server\system). Don't release those. -->
    <EmbySystemDir Condition="'$(EmbySystemDir)' == '' and '$(APPDATA)' != ''">$(APPDATA)\Emby-Server\system</EmbySystemDir>
    <RadioMetaEmbyDir Condition="'$(UseInstalledEmby)' == 'true'">$(EmbySystemDir)</RadioMetaEmbyDir>
    <RadioMetaEmbyDir Condition="'$(UseInstalledEmby)' != 'true'">$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(EmbyReferencePath)'))</RadioMetaEmbyDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(RadioMetaEmbyDir)\MediaBrowser.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(RadioMetaEmbyDir)\MediaBrowser.Controller.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(RadioMetaEmbyDir)\MediaBrowser.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebUI\RadioMetaDashboard.html" />
    <EmbeddedResource Include="WebUI\RadioMetaDashboard.js" />
    <EmbeddedResource Include="WebUI\RadioMetaPlayerIntegration.js" />
    <EmbeddedResource Include="thumb.jpg" LogicalName="RadioMeta.thumb.jpg" />
  </ItemGroup>

  <!-- Stop with a clear message instead of failing on missing references, and say which
       Emby the DLL is built against. -->
  <Target Name="CheckRadioMetaEmbyReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(RadioMetaEmbyDir)\MediaBrowser.Common.dll') or !Exists('$(RadioMetaEmbyDir)\MediaBrowser.Model.dll') or !Exists('$(RadioMetaEmbyDir)\MediaBrowser.Controller.dll')"
           Text="Radio Meta: the Emby assemblies (MediaBrowser.Common/Controller/Model.dll) are not in $(RadioMetaEmbyDir). Copy them from that Emby's system folder (see EmbyReferences\README.txt), or change EmbyReferencePath in RadioMeta.csproj." />
    <Message Importance="high" Condition="'$(UseInstalledEmby)' != 'true'" Text="Radio Meta: building against the Emby assemblies in $(RadioMetaEmbyDir)" />
    <Message Importance="high" Condition="'$(UseInstalledEmby)' == 'true'" Text="Radio Meta: TEST BUILD against the installed Emby in $(RadioMetaEmbyDir). It may not load on older Emby versions; don't release it." />
  </Target>

  <Target Name="BuildRadioMetaDashboardControllerBundle" BeforeTargets="PrepareResources">
    <!-- Build the dashboard controller from source sections before embedding the existing resource. -->
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Build-DashboardController.ps1&quot;" />
  </Target>
</Project>
