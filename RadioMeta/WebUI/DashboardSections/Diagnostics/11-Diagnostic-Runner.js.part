        function runRadioMetaDiagnostics() {
            var runButton = radioMetaById('radioDiagnosticsRun');
            var statusElement = radioMetaById('radioDiagnosticsStatus');
            var resultsElement = radioMetaById('radioDiagnosticsResults');
            if (!runButton || !statusElement || runButton.disabled) return;

            runButton.disabled = true;
            runButton.innerHTML = '<span>Running diagnostics...</span>';
            statusElement.textContent = 'Checking plugin, metadata, and Emby sessions...';
            if (resultsElement) resultsElement.style.display = 'none';
            diagnosticSetCopyButtonVisible(false);

            var checks = [];
            var startedAt = new Date();
            var dashboardControllerInfo = window.__radioMetaDashboardControllerInfo_v1353;
            diagnosticAddCheck(checks,
                dashboardControllerInfo && dashboardControllerInfo.initialized === true ? 'PASS' : 'WARN',
                'Dashboard controller bundle',
                dashboardControllerInfo
                    ? 'Version=' + String(dashboardControllerInfo.version || 'unknown') +
                        '; source mode=' + String(dashboardControllerInfo.sourceMode || 'unknown') +
                        '; sections=' + String((dashboardControllerInfo.sections || []).length) + '.'
                    : 'Dashboard controller build marker is unavailable. The browser may have an older cached controller or an incomplete dashboard resource.');
            var pagePath = String(window.location && window.location.pathname || '/');
            var userAgent = String(window.navigator && window.navigator.userAgent || 'unknown');
            var localDeviceId = '';
            try {
                if (ApiClient && typeof ApiClient.deviceId === 'function') localDeviceId = String(ApiClient.deviceId() || '');
            } catch (_) {}

            Promise.all([
                diagnosticGetJson('RadioMeta/Diagnostics/Health', 9000).then(function (value) {
                    return { ok: true, value: value };
                }).catch(function (error) {
                    return { ok: false, error: error };
                }),
                diagnosticGetJson('RadioMeta/CurrentTracks', 9000).then(function (value) {
                    return { ok: true, value: value };
                }).catch(function (error) {
                    return { ok: false, error: error };
