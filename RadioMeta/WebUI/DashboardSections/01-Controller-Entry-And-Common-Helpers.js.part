    return function (view) {
        var refreshTimer = null;
        var requestInProgress = false;
        var historyReloadPending = false;
        var historyActionInProgress = false;
        var hasLoadedOnce = false;
        var historyPanelVisible = false;
        var historyItems = [];
        var activeHistoryEditId = '';
        var ignoreRules = [];
        var ignoreRequestInProgress = false;
        var ignoreSaveInProgress = false;
        var stationModeRules = [];
        var stationModeRequestInProgress = false;
        var stationModeSaveInProgress = false;
        var pathSettingsRequestInProgress = false;
        var pathSettingsSaveInProgress = false;
        var titleCleanupRules = [];
        var titleCleanupRequestInProgress = false;
        var titleCleanupSaveInProgress = false;
        var titleCorrections = [];
        var titleCorrectionsRequestInProgress = false;
        var titleCorrectionsSaveInProgress = false;
        var titleCorrectionsLoaded = false;
        var titleCleanupRulesLoaded = false;

        // ---------------------------------------------------------------
        // Native Emby look (1.3.153). Element lookup, dialogs, confirm and
        // alert messages, fields and icons all use Emby's own modules when
        // they are available, and fall back to plain browser equivalents.
        // ---------------------------------------------------------------
        var radioMetaEmby = {};
        var radioMetaOpenDialogs = [];
        var radioMetaModulesReady = (function () {
            if (!window.Emby || typeof window.Emby.importModule !== 'function') return Promise.resolve();
            function load(key, path) {
                return window.Emby.importModule(path).then(function (module) {
                    radioMetaEmby[key] = module && module.default ? module.default : module;
                }).catch(function () { radioMetaEmby[key] = null; });
            }
            return Promise.all([
                load('dialogHelper', './modules/dialoghelper/dialoghelper.js'),
                load('confirm', './modules/common/dialogs/confirm.js'),
                load('alert', './modules/common/dialogs/alert.js'),
                load('mainTabsManager', './modules/maintabsmanager.js'),
                load('embyInput', './modules/emby-elements/emby-input/emby-input.js'),
                load('embySelect', './modules/emby-elements/emby-select/emby-select.js'),
                load('embyToggle', './modules/emby-elements/emby-toggle/emby-toggle.js'),
                load('embyButton', './modules/emby-elements/emby-button/emby-button.js'),
                load('iconButton', './modules/emby-elements/emby-button/paper-icon-button-light.js'),
                load('dialogCloseButton', './modules/emby-elements/emby-dialogclosebutton/emby-dialogclosebutton.js')
            ]);
        })();

        // Elements are found in the page and in any open Radio Meta dialog
        // (Emby places dialogs outside the page).
        function radioMetaById(id) {
            var element = view.querySelector('#' + id);
            if (element) return element;
            for (var i = 0; i < radioMetaOpenDialogs.length; i++) {
                element = radioMetaOpenDialogs[i].element.querySelector('#' + id);
                if (element) return element;
            }
            return null;
        }

        function radioMetaQueryAll(selector) {
            var found = Array.prototype.slice.call(view.querySelectorAll(selector));
            radioMetaOpenDialogs.forEach(function (entry) {
                found = found.concat(Array.prototype.slice.call(entry.element.querySelectorAll(selector)));
            });
            return found;
        }

        // Opens content in an Emby dialog. options: title, content (element),
        // key (to close it later), returnTo (element to put content back in),
        // onClose. Returns { element, close }.
        function openRadioMetaDialog(options) {
            var helper = radioMetaEmby.dialogHelper;
            var useEmby = !!(helper && typeof helper.createDialog === 'function' && typeof helper.open === 'function');
            var dlg = useEmby
                ? helper.createDialog({ removeOnClose: true, scrollY: false, size: 'small' })
                : document.createElement('div');
            var box = dlg;
            if (!useEmby) {
                dlg.className = 'radioMetaFallbackDialog';
                box = document.createElement('div');
                dlg.appendChild(box);
            }
            box.classList.add('formDialog');
            var header = document.createElement('div');
            header.className = 'formDialogHeader';
            var closeButton = document.createElement('button', useEmby ? { is: 'emby-dialogclosebutton' } : undefined);
            closeButton.type = 'button';
            if (useEmby) closeButton.setAttribute('is', 'emby-dialogclosebutton');
            else {
                closeButton.className = 'paper-icon-button-light';
                closeButton.innerHTML = '<i class="md-icon">close</i>';
                closeButton.title = 'Close';
            }
            var title = document.createElement('h3');
            title.className = 'formDialogHeaderTitle';
            title.textContent = options.title || '';
            header.appendChild(closeButton);
            header.appendChild(title);
            var content = document.createElement('div');
            content.className = 'formDialogContent';
            content.style.overflowY = 'auto';
            var inner = document.createElement('div');
            inner.className = 'dialogContentInner dialog-content-centered padded-left padded-right';
            content.appendChild(inner);
            if (options.content) inner.appendChild(options.content);
            box.appendChild(header);
            box.appendChild(content);

            var entry = { element: dlg, key: options.key || '', closed: false, observers: [] };
            // Status lines in the page are mirrored into the dialog while it is open.
            Array.prototype.slice.call(inner.querySelectorAll('[data-mirror]')).forEach(function (target) {
                var source = view.querySelector('#' + target.getAttribute('data-mirror'));
                if (!source || typeof MutationObserver !== 'function') return;
                target.textContent = '';
                var observer = new MutationObserver(function () { target.textContent = source.textContent; });
                observer.observe(source, { childList: true, characterData: true, subtree: true });
                entry.observers.push(observer);
            });
            dlg.addEventListener('click', onViewClick);

            function cleanUp() {
                if (entry.closed) return;
                entry.closed = true;
                entry.observers.forEach(function (observer) { observer.disconnect(); });
                radioMetaOpenDialogs = radioMetaOpenDialogs.filter(function (open) { return open !== entry; });
                if (options.content && options.returnTo) options.returnTo.appendChild(options.content);
                if (!useEmby && dlg.parentNode) dlg.parentNode.removeChild(dlg);
                if (typeof options.onClose === 'function') options.onClose();
            }
            entry.close = function () {
                if (entry.closed) return;
                if (useEmby) { try { helper.close(dlg); } catch (ignore) { cleanUp(); } }
                else cleanUp();
            };
            if (useEmby) dlg.addEventListener('close', cleanUp);
            else closeButton.addEventListener('click', entry.close);
            radioMetaOpenDialogs.push(entry);
            if (useEmby) helper.open(dlg);
            else document.body.appendChild(dlg);
            return entry;
        }

        function closeRadioMetaDialogs(key) {
            radioMetaOpenDialogs.slice().forEach(function (entry) {
                if (!key || entry.key === key) entry.close();
            });
        }

        // Opens one of the page's own forms (kept in .radioMetaDialogForms) in a dialog.
        function openRadioMetaFormDialog(formId, title) {
            var form = view.querySelector('#' + formId) || radioMetaById(formId);
            if (!form) return null;
            closeRadioMetaDialogs(formId);
            var home = view.querySelector('.radioMetaDialogForms');
            return openRadioMetaDialog({
                key: formId,
                title: title || form.getAttribute('data-dialog-title') || '',
                content: form,
                returnTo: home
            });
        }

        // Emby's confirm dialog; resolves true for OK, false for Cancel.
        function radioMetaConfirm(text, title) {
            var confirm = radioMetaEmby.confirm;
            if (typeof confirm === 'function') {
                return confirm({ text: text, title: title || 'Radio Meta', confirmText: 'OK' })
                    .then(function () { return true; }, function () { return false; });
            }
            return Promise.resolve(window.confirm(text));
        }

        function radioMetaAlert(text) {
            var alert = radioMetaEmby.alert;
            if (typeof alert === 'function') {
                alert({ text: String(text || ''), title: 'Radio Meta' }).catch(function () { });
                return;
            }
            window.alert(text);
        }

        // Emby's ApiClient.ajax decodes the reply only with dataType: 'json';
        // otherwise it can hand back the raw fetch Response. Decode either way,
        // so a save never mistakes an undecoded reply for empty data.
        function radioMetaReadJson(data) {
            if (data && typeof data.json === 'function') return data.json();
            if (typeof data === 'string') {
                try { return JSON.parse(data); } catch (ignore) { return data; }
            }
            if (data && typeof data === 'object') {
                if (data.responseJSON !== undefined) return data.responseJSON;
                if (typeof data.responseText === 'string') {
                    try { return JSON.parse(data.responseText); } catch (ignore) { }
                }
            }
            return data;
        }

        // An Emby text field with a floating label, as on Emby's own pages.
        function makeRadioMetaField(labelText, type, maxLength, value) {
            var container = document.createElement('div');
            container.className = 'inputContainer';
            var input;
            try { input = document.createElement('input', { is: 'emby-input' }); }
            catch (ignore) { input = document.createElement('input'); }
            input.setAttribute('is', 'emby-input');
            input.type = type || 'text';
            if (maxLength) input.maxLength = maxLength;
            input.setAttribute('label', labelText);
            input.value = value || '';
            if (!window.customElements || !window.customElements.get || !window.customElements.get('emby-input')) {
                var label = document.createElement('label');
                label.className = 'inputLabel';
                label.textContent = labelText;
                container.appendChild(label);
                input.className = 'emby-input';
            }
            container.appendChild(input);
            return { container: container, input: input };
        }

        function getValue(object, pascalName, camelName) {
            if (!object) {
                return '';
            }

            return object[pascalName] !== undefined
                ? object[pascalName]
                : (object[camelName] !== undefined
                    ? object[camelName]
                    : '');
        }

        function addText(parent, className, value, tagName) {
            var element = document.createElement(tagName || 'div');
            element.className = className;
            element.textContent = value || '';
            parent.appendChild(element);
            return element;
        }

        // Preserve the user's position when inline editors or station lists are
        // updated. Emby may scroll the page window or an internal page container,
        // so capture both instead of assuming window.scrollY is the only scroller.
        function captureRadioMetaScrollPosition() {
            var snapshot = {
                windowX: window.pageXOffset || 0,
                windowY: window.pageYOffset || 0,
                elements: []
            };
            var element = view;
            while (element && element.nodeType === 1) {
                var style = null;
                try { style = window.getComputedStyle ? window.getComputedStyle(element) : null; } catch (ignore) { }
                var overflow = style ? String(style.overflow || '') + ' ' + String(style.overflowY || '') + ' ' + String(style.overflowX || '') : '';
                if (element.scrollHeight > element.clientHeight + 1 ||
                    element.scrollWidth > element.clientWidth + 1 || /auto|scroll/i.test(overflow)) {
                    snapshot.elements.push({ element: element, top: element.scrollTop || 0, left: element.scrollLeft || 0 });
                }
                element = element.parentElement;
            }
            var scrollingElement = document.scrollingElement;
            if (scrollingElement && !snapshot.elements.some(function (entry) { return entry.element === scrollingElement; })) {
                snapshot.elements.push({ element: scrollingElement, top: scrollingElement.scrollTop || 0, left: scrollingElement.scrollLeft || 0 });
            }
            return snapshot;
        }

        function restoreRadioMetaScrollPosition(snapshot) {
            if (!snapshot) return;
            function applyPosition() {
                (snapshot.elements || []).forEach(function (entry) {
                    if (entry.element && (entry.element.isConnected !== false)) {
                        entry.element.scrollTop = entry.top;
                        entry.element.scrollLeft = entry.left;
                    }
                });
                try { window.scrollTo(snapshot.windowX || 0, snapshot.windowY || 0); } catch (ignore) { }
            }
            if (typeof window.requestAnimationFrame === 'function') {
                window.requestAnimationFrame(function () {
                    window.requestAnimationFrame(applyPosition);
                });
            } else {
                applyPosition();
            }
        }

        function focusRadioMetaWithoutScrolling(element, selectText) {
            if (!element || typeof element.focus !== 'function') return;
            try { element.focus({ preventScroll: true }); }
            catch (ignore) { element.focus(); }
            if (selectText && typeof element.select === 'function') element.select();
        }

        function formatPlayedAt(value) {
            if (!value) {
                return '';
            }

            var date = new Date(value);
            if (isNaN(date.getTime())) {
                return String(value);
            }

            return date.toLocaleString();
        }

        function showError(status, error) {
            var message = error && error.message
                ? error.message
                : String(error || 'Unknown error');

            status.textContent = 'Unable to load play history: ' + message;
            console.error('Radio Meta history:', error);
        }

        // Emby's icon buttons (Material icon font), as in Emby's own lists.
        function makeRadioMetaIconButton(button, iconName) {
            button.className = String(button.className || '')
                .replace(/\bemby-button\b|\braised\b|\bbutton-delete\b|\bbutton-submit\b/g, ' ')
                .replace(/\s+/g, ' ').trim() + ' paper-icon-button-light listItemButton';
            button.textContent = '';
            var icon = document.createElement('i');
            icon.className = 'md-icon';
            icon.setAttribute('aria-hidden', 'true');
            icon.textContent = iconName;
            button.appendChild(icon);
        }

        function makeTrashIcon(button) { makeRadioMetaIconButton(button, 'delete'); }

        function makePencilIcon(button) { makeRadioMetaIconButton(button, 'edit'); }


        var stationScanInProgress = false;
        var stationFolderPanelVisible = false;

        // Report bounded outcomes for station-file actions to the server-side diagnostic
        // history. These calls deliberately omit paths, stream URLs, library item IDs,
        // proxy tokens and raw error text. Diagnostics are best-effort and never block
        // the station operation or playback.
        function reportStationOperationResult(operationData, results) {
            var operationId = String(getValue(operationData, 'DiagnosticOperationId', 'diagnosticOperationId') || '').trim();
            if (!operationId) return Promise.resolve(null);
            var payload = { OperationId: operationId };
            if (results && results.libraryRefreshStatus) payload.LibraryRefreshStatus = results.libraryRefreshStatus;
            if (results && results.stationListRefreshStatus) payload.StationListRefreshStatus = results.stationListRefreshStatus;
            if (!payload.LibraryRefreshStatus && !payload.StationListRefreshStatus) return Promise.resolve(null);
            return ApiClient.ajax({
                type: 'POST',
                url: ApiClient.getUrl('RadioMeta/Diagnostics/StationOperationResult'),
                data: JSON.stringify(payload),
                contentType: 'application/json',
                dataType: 'json'
            }).catch(function () { return null; });
        }

        function recordStationOperationFailure(operation, stationName, failureCode) {
            var safeOperation = String(operation || '').trim();
            if (!safeOperation) return Promise.resolve(null);
            return ApiClient.ajax({
                type: 'POST',
                url: ApiClient.getUrl('RadioMeta/Diagnostics/StationOperationResult'),
                data: JSON.stringify({
                    Operation: safeOperation,
                    StationName: String(stationName || '').slice(0, 100),
                    FailureCode: failureCode === 'server-rejected' || failureCode === 'response-unexpected'
                        ? failureCode : 'request-failed'
                }),
                contentType: 'application/json',
                dataType: 'json'
            }).catch(function () { return null; });
        }

        // Uses the same native Emby operation as Dashboard > Scan library files
        // for one library root, with Recursive=true. The server resolves the
        // appropriate library ID from the configured Station Folder; no IDs or
        // credentials are hard-coded here. Report only whether Emby accepted the
        // request; the actual library scan continues in Emby's background.
        function requestTargetedLibraryRefresh(operationData) {
            var targetFound = getValue(operationData, 'LibraryScanTargetFound', 'libraryScanTargetFound') === true;
            var itemId = String(getValue(operationData, 'LibraryScanItemId', 'libraryScanItemId') || '').trim();
            var libraryName = String(getValue(operationData, 'LibraryScanLibraryName', 'libraryScanLibraryName') || '').trim();
            var libraryLocation = String(getValue(operationData, 'LibraryScanLocation', 'libraryScanLocation') || '').trim();
            var resolutionMessage = String(getValue(operationData, 'LibraryScanMessage', 'libraryScanMessage') || '').trim();

            if (!targetFound || !itemId) {
                return reportStationOperationResult(operationData, { libraryRefreshStatus: 'no-target' }).then(function () {
                    return {
                        queued: false,
                        message: (resolutionMessage ? resolutionMessage + ' ' : '') +
                            'Emby did not receive a library scan request. Use the Emby Scan library files command after confirming the Station Folder belongs to a library.'
                    };
                });
            }

            var url = ApiClient.getUrl('Items/' + encodeURIComponent(itemId) + '/Refresh');
            var refreshOptions = 'Recursive=true&ImageRefreshMode=Default&MetadataRefreshMode=Default&ReplaceAllImages=false&ReplaceAllMetadata=false';
            url += (url.indexOf('?') >= 0 ? '&' : '?') + refreshOptions;

            return ApiClient.ajax({ type: 'POST', url: url }).then(function () {
                return reportStationOperationResult(operationData, { libraryRefreshStatus: 'accepted' }).then(function () {
                    return {
                        queued: true,
                        message: 'Emby accepted a recursive library refresh for "' + (libraryName || 'the matching library') + '"' +
                            (libraryLocation ? ' (' + libraryLocation + ')' : '') + '. The scan runs in the background.'
                    };
                });
            }).catch(function (error) {
                // Do not store/display the URL or arbitrary error text: Emby clients
                // may include authentication query parameters in URLs.
                var detail = error && (error.statusText || error.status)
                    ? String(error.statusText || error.status)
                    : 'the request failed';
                return reportStationOperationResult(operationData, { libraryRefreshStatus: 'failed' }).then(function () {
                    return {
                        queued: false,
                        message: 'The station file operation succeeded, but Emby did not accept the targeted library refresh (' + detail + '). Use the Emby Scan library files command if the change does not appear.'
                    };
                });
            });
        }

